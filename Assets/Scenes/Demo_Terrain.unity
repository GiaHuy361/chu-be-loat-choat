  mission3_EscortNPC: {fileID: 502842421}
  mission3_Goal: {fileID: 794558766}
  mission3_StartPoint: {fileID: 1441246954}
  mission3_EscortActive: 0
  mission3_AutoStartEscortOnEnter: 1
  mission3_ReminderInterval: 18
  mission3_Brief_1: "H\u1EC7 th\u1ED1ng: Nhi\u1EC7m v\u1EE5 3 b\u1EAFt \u0111\u1EA7u.
    \u0110\u1ED3ng ch\xED ph\u1EA3i h\u1ED9 t\u1ED1ng c\xE1n b\u1ED9 v\u01B0\u1EE3t
    qua khu v\u1EF1c nguy hi\u1EC3m trong \u0111\xEAm."
  mission3_Brief_2: "H\u1EC7 th\u1ED1ng: Tuy\u1EC7t \u0111\u1ED1i tr\xE1nh v\xF9ng
    ph\xE1t hi\u1EC7n c\u1EE7a l\xEDnh g\xE1c. N\u1EBFu b\u1ECB l\u1ED9, nhi\u1EC7m
    v\u1EE5 s\u1EBD th\u1EA5t b\u1EA1i."
  mission3_Brief_3: "Kim \u0110\u1ED3ng: R\xF5! T\xF4i s\u1EBD d\u1EABn \u0111\u01B0\u1EDDng
    an to\xE0n."
  mission3_ApproachNPC_1: "H\u1EC7 th\u1ED1ng: Ti\u1EBFp c\u1EADn c\xE1n b\u1ED9
    \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u h\u1ED9 t\u1ED1ng."
  mission3_ApproachNPC_2: "Kim \u0110\u1ED3ng: \u0110\u1ED3ng ch\xED theo s\xE1t
    t\xF4i, \u0111i th\u1EA5p ng\u01B0\u1EDDi\u2026 \u0111\u1EEBng \u0111\u1EC3 h\u1ECD
    ph\xE1t hi\u1EC7n."
  mission3_StartEscort_1: "C\xE1n b\u1ED9: C\u1EA3m \u01A1n \u0111\u1ED3ng ch\xED.
    Ta ph\u1EA3i r\xFAt ngay, \u0111\u1ECBch tu\u1EA7n tra r\u1EA5t g\u1EAFt!"
  mission3_StartEscort_2: "Kim \u0110\u1ED3ng: Theo t\xF4i. N\u1EBFu nguy hi\u1EC3m,
    d\u1EEBng l\u1EA1i, ch\u1EDD t\xEDn hi\u1EC7u r\u1ED3i \u0111i ti\u1EBFp."
  mission3_Reminder_1: "H\u1EC7 th\u1ED1ng: Gi\u1EEF kho\u1EA3ng c\xE1ch h\u1EE3p
    l\xFD \u0111\u1EC3 c\xE1n b\u1ED9 kh\xF4ng b\u1ECB t\u1EE5t l\u1EA1i."
  mission3_Reminder_2: "H\u1EC7 th\u1ED1ng: Tr\xE1nh \xE1nh s\xE1ng v\xE0 v\xF9ng
    ph\xE1t hi\u1EC7n. \u01AFu ti\xEAn \u0111i s\xE1t \u0111\u1ECBa h\xECnh che khu\u1EA5t."
  mission3_Reminder_3: "Kim \u0110\u1ED3ng: B\xECnh t\u0129nh\u2026 ch\u1EADm m\xE0
    ch\u1EAFc."
  mission3WinCongratsMessage: "Ch\xFAc m\u1EEBng \u0111\u1ED3ng ch\xED! \U0001F389\nB\u1EA1n
    \u0111\xE3 h\u1ED9 t\u1ED1ng c\xE1n b\u1ED9 an to\xE0n v\xE0 ho\xE0n th\xE0nh
    Nhi\u1EC7m v\u1EE5 3!"
  mission3WinCongratsDuration: 2.5
